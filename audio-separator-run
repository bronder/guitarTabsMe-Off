#!/bin/sh
# audio-separator launcher: same PYTHONPATH workaround as demucs-run
# (sandbox breaks CPython venv detection).
BASE="$(cd "$(dirname "$0")" && pwd)"
export PYTHONPATH="$BASE/.venv-demucs/lib/python3.12/site-packages${PYTHONPATH:+:$PYTHONPATH}"
exec "$BASE/.venv-demucs/bin/audio-separator" "$@"
